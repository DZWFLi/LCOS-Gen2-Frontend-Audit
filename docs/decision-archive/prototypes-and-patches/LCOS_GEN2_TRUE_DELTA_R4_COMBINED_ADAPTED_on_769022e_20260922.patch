@@ -0,0 +1,86 @@
+// @vitest-environment happy-dom
+import { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import {
+  ProjectCardView,
+  ProjectDialogField,
+  ProjectDialogView,
+  ProjectLauncherTabsView,
+  ProjectSearchView,
+} from './ProjectLauncherViews';
+
+import type { ReactNode } from 'react';
+
+const mounted: { root: ReturnType<typeof createRoot>; host: HTMLDivElement }[] = [];
+async function mount(node: ReactNode): Promise<HTMLDivElement> {
+  const host = document.createElement('div');
+  document.body.append(host);
+  const root = createRoot(host);
+  mounted.push({ root, host });
+  await act(async () => root.render(node));
+  return host;
+}
+
+afterEach(async () => {
+  for (const { root, host } of mounted.splice(0)) {
+    await act(async () => root.unmount());
+    host.remove();
+  }
+});
+
+describe('Project launcher Figma presentation', () => {
+  it('does not invent the archive action when production has no caller', async () => {
+    const change = vi.fn();
+    const host = await mount(<ProjectLauncherTabsView value="recent" onChange={change} />);
+    expect(host.querySelectorAll('button')).toHaveLength(2);
+    expect(host.textContent).not.toContain('归档');
+    await act(async () => host.querySelectorAll<HTMLButtonElement>('button')[1]?.click());
+    expect(change).toHaveBeenCalledWith('all');
+  });
+
+  it('renders a neutral project cover instead of fabricating a photo', async () => {
+    const host = await mount(<ProjectCardView title="真实项目" meta="主画布 · 今天" rootPath="D:/Projects/real" onOpen={() => undefined} />);
+    expect(host.querySelector('img')).toBeNull();
+    expect(host.querySelector('.lcos-launcher-project-cover-empty')).not.toBeNull();
+    expect(host.querySelector('button')?.title).toBe('D:/Projects/real');
+  });
+
+  it('uses the exact supplied preview only when a real one exists', async () => {
+    const host = await mount(<ProjectCardView title="真实项目" meta="主画布 · 今天" rootPath="D:/Projects/real" previewUrl="blob:project-preview" onOpen={() => undefined} />);
+    expect(host.querySelector('img')?.getAttribute('src')).toBe('blob:project-preview');
+  });
+
+  it('preserves disabled opening state and native click semantics', async () => {
+    const open = vi.fn();
+    const host = await mount(<ProjectCardView title="项目" meta="主画布" rootPath="D:/p" disabled onOpen={open} />);
+    const button = host.querySelector<HTMLButtonElement>('button');
+    expect(button?.disabled).toBe(true);
+    await act(async () => button?.click());
+    expect(open).not.toHaveBeenCalled();
+  });
+
+  it('keeps launcher search as one native input with explicit clear', async () => {
+    const change = vi.fn();
+    const clear = vi.fn();
+    const host = await mount(<ProjectSearchView value="山野" onChange={change} onClear={clear} />);
+    expect(host.querySelectorAll('input')).toHaveLength(1);
+    await act(async () => host.querySelector<HTMLButtonElement>('[aria-label="清空搜索"]')?.click());
+    expect(clear).toHaveBeenCalledTimes(1);
+  });
+
+  it('dismisses the dialog on Escape without manufacturing a submit', async () => {
+    const dismiss = vi.fn();
+    const submit = vi.fn();
+    await mount(
+      <ProjectDialogView title="新建项目" ariaLabel="新建项目" primaryLabel="创建项目" onPrimary={submit}
+        alternateLead="已有项目？" alternateLabel="打开项目文件夹" onAlternate={() => undefined} onDismiss={dismiss}>
+        <ProjectDialogField label="项目名称" value="" onChange={() => undefined} />
+      </ProjectDialogView>,
+    );
+    await act(async () => document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true })));
+    expect(dismiss).toHaveBeenCalledTimes(1);
+    expect(submit).not.toHaveBeenCalled();
+  });
+});
