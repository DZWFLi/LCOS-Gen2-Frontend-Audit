@@ -0,0 +1,38 @@
+// LcosMiniMapOverlay — LCOS chrome reuses Huabu/ReactFlow's native MiniMap.
+// No second camera, node graph, or minimap store is created: visibility is the
+// existing canvasStore preference, pan/zoom operate on the mounted ReactFlow,
+// and only the screen-space shell geometry is LCOS-specific.
+
+import { MiniMap } from '@xyflow/react';
+
+import useCanvasStore from '@/store/canvasStore';
+
+import { lcosMinimapPlacement } from '../shell/lcosHudPlacement';
+import { useLcosShellStore } from '../shell/lcosShellStore';
+import { useLcosViewportSize } from '../shell/useLcosViewportSize';
+
+export function LcosMiniMapOverlay(): React.JSX.Element | null {
+  const enabled = useCanvasStore((state) => state.minimapEnabled);
+  const windowEnvironment = useLcosShellStore((state) => state.windowEnvironment);
+  const viewport = useLcosViewportSize();
+  if (!enabled) return null;
+
+  const placement = lcosMinimapPlacement(windowEnvironment, viewport);
+  return (
+    <MiniMap
+      data-lcos-minimap
+      pannable
+      zoomable
+      ariaLabel="项目小地图"
+      position="bottom-left"
+      className="lcos-minimap"
+      style={{
+        left: placement.left,
+        bottom: placement.bottom,
+        width: placement.width,
+        height: placement.height,
+        margin: 0,
+      }}
+    />
+  );
+}
