@@ -0,0 +1,58 @@
+import type { CSSProperties, ReactNode } from 'react';
+
+import './lcos-floating-surfaces.css';
+
+export interface LcosObjectCommandMenuItem {
+  readonly id: string;
+  readonly label: string;
+  readonly shortcut?: string | undefined;
+  readonly disabledReason?: string | undefined;
+  readonly danger?: boolean | undefined;
+  readonly icon?: ReactNode | undefined;
+  readonly onSelect: () => void;
+}
+
+export interface LcosObjectCommandMenuViewProps {
+  readonly items: readonly LcosObjectCommandMenuItem[];
+  readonly label?: string | undefined;
+}
+
+/**
+ * Figma 5187:921 object menu presentation.
+ *
+ * Position/dismiss/clamp/focus ownership stays in Huabu Popover. This view only
+ * paints the menu body. Five rows produce the exact 248×265 Figma specimen;
+ * additional real commands extend by the same 47px cadence instead of being
+ * hidden to preserve a screenshot.
+ */
+export function LcosObjectCommandMenuView({ items, label = '节点命令' }: LcosObjectCommandMenuViewProps): React.JSX.Element {
+  return (
+    <div
+      data-lcos-object-command-menu
+      data-figma-node-id="5187:921"
+      className="lcos-object-command-menu"
+      role="menu"
+      aria-label={label}
+      style={{ '--lcos-object-menu-rows': items.length } as CSSProperties}
+    >
+      {items.map((item) => (
+        <button
+          key={item.id}
+          type="button"
+          role="menuitem"
+          data-lcos-context-command={item.id}
+          data-danger={item.danger || undefined}
+          disabled={item.disabledReason !== undefined}
+          title={item.disabledReason ?? item.label}
+          aria-label={item.disabledReason ? `${item.label}，${item.disabledReason}` : item.label}
+          onClick={item.onSelect}
+          className="lcos-object-command-menu-row"
+        >
+          {item.icon ? <span className="lcos-object-command-menu-icon" aria-hidden>{item.icon}</span> : null}
+          <span className="lcos-object-command-menu-label">{item.label}</span>
+          {item.shortcut ? <kbd className="lcos-object-command-menu-shortcut">{item.shortcut}</kbd> : null}
+        </button>
+      ))}
+    </div>
+  );
+}
diff --git a/huabu/apps/web/src/lcos/ui/nearfield/lcos-floating-surfaces.css b/huabu/apps/web/src/lcos/ui/nearfield/lcos-floating-surfaces.css
new file mode 100644
index 0000000..80920cf
--- /dev/null
+++ b/huabu/apps/web/src/lcos/ui/nearfield/lcos-floating-surfaces.css
@@ -0,0 +1,177 @@
+/* LCOS floating presentation surfaces.
+   Mechanics remain Huabu Popover/Tooltip/CanvasFloatingPopover owners. */
+
+.lcos-object-command-menu,
+.lcos-arc-more-panel {
+  box-sizing: border-box;
+  font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
+  color: var(--gen2-text, #242625);
+}
+
+/* Figma 5187:921 — 248×265 at 5 rows, 47px row cadence. */
+.lcos-object-command-popover {
+  padding: 0 !important;
+  overflow: visible !important;
+  border: 0 !important;
+  border-radius: 15px !important;
+  background: transparent !important;
+  box-shadow: none !important;
+}
+.lcos-object-command-menu {
+  width: 248px;
+  max-width: calc(100vw - 24px);
+  min-height: calc(var(--lcos-object-menu-rows, 0) * 47px + 30px);
+  padding: 2px 0 26px;
+  overflow: hidden;
+  border: 1px solid var(--gen2-border, #e7e9e7);
+  border-radius: 15px;
+  background: var(--gen2-surface, #fff);
+  box-shadow: 0 12px 18px rgb(0 0 0 / 8%);
+  backdrop-filter: blur(3px);
+  -webkit-backdrop-filter: blur(3px);
+}
+.lcos-object-command-menu-row {
+  box-sizing: border-box;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 70px;
+  align-items: center;
+  width: 100%;
+  height: 47px;
+  min-height: 47px;
+  padding: 0 1px 0 16px;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  color: var(--gen2-text, #242625);
+  text-align: left;
+  cursor: pointer;
+}
+.lcos-object-command-menu-row:hover:not(:disabled) { background: color-mix(in srgb, var(--gen2-text, #242625) 4%, transparent); }
+.lcos-object-command-menu-row:active:not(:disabled) { background: color-mix(in srgb, var(--gen2-text, #242625) 7%, transparent); }
+.lcos-object-command-menu-row:focus-visible { outline: 2px solid var(--lcos-pin-violet, #6371dd); outline-offset: -3px; }
+.lcos-object-command-menu-row:disabled { cursor: not-allowed; opacity: .45; }
+.lcos-object-command-menu-row[data-danger] { color: var(--gen2-error, var(--lcos-status-danger, #a14e48)); }
+.lcos-object-command-menu-label {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 12px;
+  font-weight: 400;
+  line-height: 19px;
+}
+.lcos-object-command-menu-shortcut {
+  justify-self: start;
+  min-width: 0;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--gen2-muted, #69716b);
+  font: 400 10px/16px 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+}
+.lcos-object-command-menu-icon { display: none; }
+
+/* Figma 5226:1264 — Action Arc "more" popover body. */
+.lcos-arc-more-panel {
+  position: relative;
+  width: 238px;
+  max-width: min(238px, calc(100vw - 24px));
+  max-height: min(46vh, 440px);
+  overflow: auto;
+  padding: 37px 6px 16px;
+  border: 1px solid rgb(255 255 255 / 90%);
+  border-radius: 15px;
+  background: #f6f8fa;
+  box-shadow: 0 10px 13px rgb(33 48 69 / 14%);
+  backdrop-filter: blur(9px);
+  -webkit-backdrop-filter: blur(9px);
+}
+.dark .lcos-arc-more-panel {
+  background: var(--gen2-raised, #202322);
+  border-color: rgb(255 255 255 / 14%);
+}
+.lcos-arc-more-title {
+  position: absolute;
+  left: 13px;
+  right: 36px;
+  top: 11px;
+  overflow: hidden;
+  color: var(--gen2-muted, #69716b);
+  font-size: 11px;
+  font-weight: 400;
+  line-height: 18px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.lcos-arc-more-close {
+  position: absolute;
+  right: 3px;
+  top: -2px;
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  padding: 0;
+  border: 0;
+  border-radius: 50%;
+  background: transparent;
+  color: var(--gen2-text, #242625);
+}
+.lcos-arc-more-close > svg { width: 12px; height: 12px; }
+.lcos-arc-more-close:hover { background: color-mix(in srgb, var(--gen2-text, #242625) 4%, transparent); }
+.lcos-arc-more-row,
+.lcos-arc-more-control-row {
+  box-sizing: border-box;
+  width: 224px;
+  min-height: 39px;
+  margin: 0;
+  border: 0;
+  border-radius: var(--lcos-radius-control, 8px);
+  background: transparent;
+  color: var(--gen2-text, #242625);
+}
+.lcos-arc-more-row {
+  display: grid;
+  grid-template-columns: 20px minmax(0, 1fr);
+  align-items: start;
+  gap: 8px;
+  padding: 6px 10px;
+  text-align: left;
+  font-size: 12px;
+  font-weight: 400;
+  line-height: 18px;
+}
+.lcos-arc-more-row > svg { width: 16px; height: 16px; justify-self: center; margin-top: 2px; }
+.lcos-arc-more-row:hover:not(:disabled) { background: color-mix(in srgb, var(--gen2-text, #242625) 4%, transparent); }
+.lcos-arc-more-row:disabled { opacity: .45; cursor: not-allowed; }
+.lcos-arc-more-row:focus-visible,
+.lcos-arc-more-control-row :focus-visible,
+.lcos-arc-more-close:focus-visible { outline: 2px solid var(--lcos-pin-violet, #6371dd); outline-offset: -2px; }
+.lcos-arc-more-control-row { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; padding: 5px 10px; font-size: 11px; }
+.lcos-arc-more-divider { height: 1px; margin: 0 7px; background: var(--gen2-border, #e7e9e7); }
+
+/* Figma 5137:53 — tooltip face. Huabu Tooltip keeps delay/focus/dismiss/flip/shift. */
+.lcos-action-orb-tooltip {
+  box-sizing: border-box;
+  min-height: 32px;
+  padding: 7px 12px !important;
+  border-radius: 9px !important;
+  background: var(--gen2-text, #242625) !important;
+  color: var(--gen2-surface, #fff) !important;
+  box-shadow: none !important;
+  font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
+  font-size: 11px !important;
+  font-weight: 400;
+  line-height: 18px !important;
+  white-space: nowrap;
+}
+
+@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
+  .lcos-object-command-menu,
+  .lcos-arc-more-panel { background: var(--gen2-surface, #fff); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .lcos-object-command-menu-row,
+  .lcos-arc-more-row,
+  .lcos-arc-more-close { transition: none !important; }
+}
