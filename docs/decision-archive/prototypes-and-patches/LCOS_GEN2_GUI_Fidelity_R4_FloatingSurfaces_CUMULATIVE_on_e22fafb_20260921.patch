+      { id: 'focus', label: '聚焦所选', shortcut: 'F', onSelect: focus },
+      { id: 'rename', label: '重命名', shortcut: 'F2', onSelect: rename },
+      { id: 'copy', label: '复制', shortcut: 'Ctrl C', onSelect: vi.fn() },
+      { id: 'duplicate', label: '重复', shortcut: 'Ctrl D', onSelect: vi.fn() },
+      { id: 'delete', label: '从画布移除', shortcut: 'Delete', danger: true, onSelect: remove },
+    ]} />,
+  ));
+  return { host, focus, rename, remove };
+}
+
+afterEach(async () => {
+  if (root) await act(async () => root?.unmount());
+  host?.remove();
+  root = undefined;
+  host = undefined;
+});
+
+describe('Figma 5187:921 LCOS object command menu view', () => {
+  it('renders one menu root and five native menuitem buttons', async () => {
+    const { host } = await renderMenu();
+    expect(host.querySelectorAll('[role="menu"]')).toHaveLength(1);
+    expect(host.querySelectorAll('[role="menuitem"]')).toHaveLength(5);
+    expect(host.querySelector('[data-figma-node-id="5187:921"]')).not.toBeNull();
+  });
+
+  it('keeps shortcut copy and destructive presentation separate from command ownership', async () => {
+    const { host } = await renderMenu();
+    expect([...host.querySelectorAll('kbd')].map((node) => node.textContent)).toEqual(['F', 'F2', 'Ctrl C', 'Ctrl D', 'Delete']);
+    expect(host.querySelector('[data-lcos-context-command="delete"]')?.getAttribute('data-danger')).toBe('true');
+  });
+
+  it('dispatches only the callback belonging to the activated row', async () => {
+    const { host, focus, rename, remove } = await renderMenu();
+    await act(async () => (host.querySelector('[data-lcos-context-command="rename"]') as HTMLButtonElement).click());
+    expect(rename).toHaveBeenCalledTimes(1);
+    expect(focus).not.toHaveBeenCalled();
+    expect(remove).not.toHaveBeenCalled();
+  });
+});
diff --git a/huabu/apps/web/src/lcos/ui/nearfield/LcosObjectCommandMenuView.tsx b/huabu/apps/web/src/lcos/ui/nearfield/LcosObjectCommandMenuView.tsx
