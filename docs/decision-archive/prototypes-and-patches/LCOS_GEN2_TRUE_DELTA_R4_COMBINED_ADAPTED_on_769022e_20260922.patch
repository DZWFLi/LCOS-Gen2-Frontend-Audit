+  backdrop-filter: blur(9px);
+  -webkit-backdrop-filter: blur(9px);
+}
+.dark .lcos-arc-more-panel {
+  background: var(--gen2-raised, #202322);
+  border-color: rgb(255 255 255 / 14%);
+}
+.lcos-arc-more-title {
+  position: absolute;
+  left: 13px;
+  right: 36px;
+  top: 11px;
+  overflow: hidden;
+  color: var(--gen2-muted, #69716b);
+  font-size: 11px;
+  font-weight: 400;
+  line-height: 18px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.lcos-arc-more-close {
+  position: absolute;
+  right: 3px;
+  top: -2px;
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  padding: 0;
+  border: 0;
