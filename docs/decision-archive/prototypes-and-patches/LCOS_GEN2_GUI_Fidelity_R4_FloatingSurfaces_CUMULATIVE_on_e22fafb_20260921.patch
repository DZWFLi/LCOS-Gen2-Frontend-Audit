+import { useEffect, type ReactNode } from 'react';
+import { LcosButton } from '../primitives/LcosButton';
+import { LcosIconButton } from '../primitives/LcosIconButton';
+
+import './project-launcher.css';
+
+export type ProjectLauncherTab = 'recent' | 'all';
+
+export function ProjectLauncherTabsView(props: {
+  readonly value: ProjectLauncherTab;
+  readonly onChange: (value: ProjectLauncherTab) => void;
+  readonly archiveAction?: (() => void) | undefined;
+}): React.JSX.Element {
+  return (
+    <div className="lcos-launcher-tabs" data-lcos-launcher-tabs aria-label="项目范围">
+      <LcosButton
+        appearance="oreo"
+        variant={props.value === 'recent' ? 'primary' : 'secondary'}
+        className="lcos-launcher-tab"
+        aria-pressed={props.value === 'recent'}
+        onClick={() => props.onChange('recent')}
+      >最近</LcosButton>
+      <LcosButton
+        appearance="oreo"
+        variant={props.value === 'all' ? 'primary' : 'secondary'}
+        className="lcos-launcher-tab"
+        aria-pressed={props.value === 'all'}
+        onClick={() => props.onChange('all')}
+      >全部</LcosButton>
+      {props.archiveAction ? (
+        <LcosButton appearance="oreo" variant="secondary" className="lcos-launcher-tab" onClick={props.archiveAction}>
+          归档
+        </LcosButton>
+      ) : null}
+    </div>
+  );
+}
+
+export function ProjectSearchView(props: {
+  readonly value: string;
+  readonly onChange: (value: string) => void;
+  readonly onClear: () => void;
+}): React.JSX.Element {
+  return (
+    <label className="lcos-launcher-search" data-lcos-launcher-search>
+      <span className="lcos-launcher-search-label">搜索项目</span>
+      <span className="lcos-launcher-search-field">
+        <input
+          value={props.value}
+          onChange={(event) => props.onChange(event.target.value)}
+          placeholder="名称或关键词"
+          aria-label="搜索项目"
+        />
+        {props.value !== '' ? (
+          <LcosIconButton appearance="oreo" variant="ghost" size="sm" aria-label="清空搜索" className="lcos-launcher-search-clear" onClick={props.onClear}>
+            <span aria-hidden="true">×</span>
+          </LcosIconButton>
+        ) : null}
+      </span>
+    </label>
+  );
+}
+
+export function ProjectCardView(props: {
+  readonly title: string;
+  readonly meta: string;
+  readonly rootPath: string;
+  readonly previewUrl?: string | undefined;
+  readonly disabled?: boolean | undefined;
+  readonly onOpen: () => void;
+}): React.JSX.Element {
+  return (
+    <button
+      type="button"
+      className="lcos-launcher-project-card"
+      disabled={props.disabled}
+      onClick={props.onOpen}
+      title={props.rootPath}
+      data-lcos-launcher-project-card
+    >
+      <span className="lcos-launcher-project-cover" aria-hidden="true">
+        {props.previewUrl ? <img src={props.previewUrl} alt="" draggable={false} /> : <span className="lcos-launcher-project-cover-empty" />}
+      </span>
+      <span className="lcos-launcher-project-title">{props.title}</span>
+      <span className="lcos-launcher-project-meta">{props.meta}</span>
+    </button>
+  );
+}
+
+export function ProjectDialogField(props: {
+  readonly label: string;
+  readonly value: string;
+  readonly onChange: (value: string) => void;
+  readonly placeholder?: string | undefined;
+  readonly autoFocus?: boolean | undefined;
+}): React.JSX.Element {
+  return (
+    <label className="lcos-launcher-dialog-field">
+      <span>{props.label}</span>
+      <input
+        value={props.value}
+        onChange={(event) => props.onChange(event.target.value)}
+        placeholder={props.placeholder}
+        autoFocus={props.autoFocus}
+      />
+    </label>
+  );
+}
+
+export function ProjectDialogView(props: {
+  readonly title: string;
+  readonly ariaLabel: string;
+  readonly children: ReactNode;
+  readonly error?: string | undefined;
+  readonly primaryLabel: string;
+  readonly primaryBusy?: boolean | undefined;
+  readonly onPrimary: () => void;
+  readonly alternateLead: string;
+  readonly alternateLabel: string;
+  readonly onAlternate: () => void;
+  readonly onDismiss: () => void;
+}): React.JSX.Element {
+  const onDismiss = props.onDismiss;
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent): void => {
+      if (event.key !== 'Escape') return;
+      event.preventDefault();
+      event.stopPropagation();
+      onDismiss();
+    };
+    document.addEventListener('keydown', onKeyDown, true);
+    return () => document.removeEventListener('keydown', onKeyDown, true);
+  }, [onDismiss]);
+
+  return (
+    <div className="lcos-launcher-dialog-layer" data-lcos-launcher-dialog-layer>
+      <button type="button" className="lcos-launcher-dialog-dismiss" tabIndex={-1} aria-label="关闭对话框" onClick={props.onDismiss} />
+      <section className="lcos-launcher-dialog" role="dialog" aria-modal="true" aria-label={props.ariaLabel} data-lcos-launcher-dialog>
+        <h2>{props.title}</h2>
+        <div className="lcos-launcher-dialog-fields">{props.children}</div>
+        {props.error ? <div className="lcos-launcher-dialog-error" role="alert">{props.error}</div> : null}
+        <LcosButton
+          appearance="oreo"
+          variant="primary"
+          className="lcos-launcher-dialog-primary lcos-launcher-instance-button"
+          disabled={props.primaryBusy}
+          onClick={props.onPrimary}
+        >
+          {props.primaryLabel}
+        </LcosButton>
+        <div className="lcos-launcher-dialog-divider" aria-hidden="true" />
+        <div className="lcos-launcher-dialog-alternate">
+          <span>{props.alternateLead}</span>
+          <LcosButton appearance="oreo" variant="secondary" className="lcos-launcher-dialog-alt lcos-launcher-instance-button" onClick={props.onAlternate}>
+            {props.alternateLabel}
+          </LcosButton>
+        </div>
+      </section>
+    </div>
+  );
+}
