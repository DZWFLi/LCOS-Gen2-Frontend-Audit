+/* Figma C01 5346:1416. Current Source Bay + CSS columns retained; Lovart is behavior-only evidence. */
+.lcos-assembly-body {
+  container-type: inline-size;
+  box-sizing: border-box;
+  min-inline-size: 0;
+  inline-size: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  padding: 24px 32px;
+  color: var(--gen2-text);
+  background: var(--gen2-surface);
+  font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+}
+.lcos-assembly-source-tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-inline-size: 0; }
+.lcos-assembly-source-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+.lcos-assembly-source-buttons button {
+  min-inline-size: 44px;
+  min-block-size: 44px;
+  padding: 8px 12px;
+  border: 0;
+  border-radius: var(--lcos-radius-control, 8px);
+  color: var(--gen2-muted);
+  background: transparent;
+  font: inherit;
+  font-size: 12px;
+  line-height: 18px;
+  cursor: pointer;
+  transition: background 120ms ease, color 120ms ease;
+}
+.lcos-assembly-source-buttons button:hover:not(:disabled) { background: var(--gen2-raised); color: var(--gen2-text); }
+.lcos-assembly-source-buttons button[aria-pressed='true'] { background: var(--lcos-color-bg-inverse); color: var(--lcos-color-text-on-inverse); }
+.lcos-assembly-source-buttons button:disabled { opacity: 0.45; cursor: not-allowed; }
+.lcos-assembly-target-context { flex: 1 1 100%; min-inline-size: 0; overflow-wrap: anywhere; font-size: 11px; line-height: 18px; color: var(--gen2-muted); }
+.lcos-assembly-body [data-lcos-assembly-source-panel] { min-inline-size: 0; }
+.lcos-assembly-body form { flex-wrap: wrap; }
+.lcos-assembly-body form label { min-inline-size: 120px; }
+.lcos-assembly-body [data-lcos-assembly-search] { min-inline-size: 0; inline-size: 100%; font-size: 14px; line-height: 20px; }
