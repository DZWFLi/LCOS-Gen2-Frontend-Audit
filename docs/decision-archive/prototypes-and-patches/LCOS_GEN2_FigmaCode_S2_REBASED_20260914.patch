+      artifactId: 'image-main',
+      kind: 'image',
+      title: 'Main image',
+      displayMode: 'card',
+    },
+  ]);
+
+  assert.equal(result[0]?.spatialId, 'persisted-image');
+  assert.equal(createCount, 0, 'existing node must never be resized/recreated by Figma preset reconciliation');
+});
