+/* Reader body only. Figma 5388:27484–27492; Stage still owns the window and its geometry. */
+.lcos-reader-body {
+  container-type: inline-size;
+  box-sizing: border-box;
+  inline-size: 100%;
+  block-size: 100%;
+  min-inline-size: 0;
+  min-block-size: 320px;
+  padding: 24px 32px;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  background: var(--gen2-surface);
+  color: var(--gen2-text);
+  font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+}
+.lcos-reader-heading { inline-size: 100%; max-inline-size: 62ch; margin-inline: auto; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12px; }
+.lcos-reader-heading > :first-child { flex: 1; min-inline-size: 0; }
+.lcos-reader-title {
+  margin: 0;
+  font-size: 27px;
+  line-height: 42px;
+  font-weight: 500;
+  overflow-wrap: anywhere;
+}
+.lcos-reader-heading p { margin: 4px 0 0; font-size: 11px; line-height: 18px; }
+.lcos-reader-page, .lcos-reader-media-page, .lcos-reader-unavailable {
+  box-sizing: border-box;
+  min-inline-size: 0;
+  min-block-size: 0;
+  flex: 1 1 0;
+  overflow: auto;
+  scrollbar-gutter: stable;
+  overscroll-behavior: contain;
+  color: var(--gen2-text);
+  background: var(--gen2-surface);
+}
+.lcos-reader-page { padding: 18px 12px; }
+.lcos-reader-measure { inline-size: 100%; max-inline-size: 62ch; margin-inline: auto; }
+.lcos-reader-plaintext {
+  margin: 0;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  tab-size: 4;
+  font-family: inherit;
+  font-size: 16px;
+  line-height: 25px;
+  font-weight: 400;
+}
+.lcos-reader-richtext { font-size: 16px; line-height: 25px; overflow-wrap: anywhere; }
+.lcos-reader-richtext > :first-child { margin-block-start: 0; }
+.lcos-reader-richtext h1 { font-size: 27px; line-height: 42px; font-weight: 500; }
+.lcos-reader-richtext h2 { font-size: 18px; line-height: 28px; font-weight: 500; }
+.lcos-reader-richtext h3 { font-size: 13px; line-height: 21px; font-weight: 500; }
+.lcos-reader-richtext p { margin-block: 0 18px; }
+.lcos-reader-richtext blockquote { margin-inline: 0; color: var(--gen2-accent); font-size: 18px; line-height: 28px; }
+.lcos-reader-richtext img, .lcos-reader-richtext video { max-inline-size: 100%; block-size: auto; }
+.lcos-reader-richtext pre { overflow: auto; }
+.lcos-reader-media-page { padding: 18px 12px; }
+.lcos-reader-figure { margin: 0; display: flex; flex-direction: column; gap: 18px; }
+.lcos-reader-image {
+  display: block;
+  inline-size: 100%;
+  max-inline-size: 100%;
+  max-block-size: min(52vh, 520px);
+  object-fit: contain;
+  border-radius: 10px;
+  background: var(--lcos-surface-elevated, var(--gen2-raised));
+}
+.lcos-reader-media-caption { font-size: 11px; line-height: 18px; color: var(--gen2-muted); overflow-wrap: anywhere; }
+.lcos-reader-unavailable { min-block-size: 240px; display: grid; place-content: center; justify-items: center; gap: 12px; padding: 24px; font-size: 13px; line-height: 21px; text-align: center; color: var(--gen2-muted); }
+.lcos-reader-unavailable-glyph { display: inline-flex; inline-size: 24px; block-size: 24px; }
+.lcos-reader-body [data-lcos-reader-revisions] { gap: 6px; }
+.lcos-reader-body [data-lcos-reader-revisions] button,
+.lcos-reader-body [data-lcos-reader-actions] button {
+  min-block-size: 44px;
+  border-radius: var(--lcos-radius-control, 8px);
+  padding: 8px 10px;
+  font-size: 12px;
+  line-height: 18px;
+}
+.lcos-reader-body [data-lcos-reader-actions] { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.lcos-reader-body button:focus-visible, .lcos-reader-group :is(button, a):focus-visible {
+  outline: 2px solid var(--gen2-accent);
+  outline-offset: 2px;
+}
+.lcos-reader-body button:disabled { opacity: 0.45; cursor: not-allowed; }
+.lcos-reader-body [data-lcos-reader-compare] { font-family: ui-monospace, monospace; }
+.lcos-reader-body [data-lcos-reader-compare-line] { font-size: 12px; line-height: 20px; }
+.lcos-professional-sr-only { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+
+/* Controlled split/single variant. Never creates or selects a group. */
+.lcos-reader-groups { container-type: inline-size; inline-size: 100%; min-inline-size: 0; font-family: 'Noto Sans SC', sans-serif; }
+.lcos-reader-group-columns { display: flex; align-items: stretch; min-inline-size: 0; }
+.lcos-reader-group { display: flex; flex: 1 1 0; min-inline-size: 0; flex-direction: column; }
+.lcos-reader-group[hidden] { display: none; }
+.lcos-reader-group + .lcos-reader-group { border-inline-start: 1px solid var(--gen2-border); }
+[data-reader-group-layout='single'] .lcos-reader-group { border-inline-start: 0; }
+.lcos-reader-group-tabs, .lcos-reader-group-selector { display: flex; align-items: center; gap: 6px; padding: 12px 18px; overflow-x: auto; }
+.lcos-reader-group-content { min-inline-size: 0; flex: 1; padding: 24px 32px; }
+.lcos-reader-group-footer { padding: 12px 18px 24px; }
+@container (max-width: 620px) {
+  .lcos-reader-page, .lcos-reader-media-page { padding-inline: 0; }
+  .lcos-reader-group-content { padding-inline: 18px; }
+}
+@media (max-width: 480px) {
+  .lcos-reader-body { padding-inline: 16px; }
+  .lcos-reader-group-content { padding-inline: 12px; }
+}
+@media (forced-colors: active) {
+  .lcos-reader-body button, .lcos-reader-group { border: 1px solid ButtonText; }
+}
