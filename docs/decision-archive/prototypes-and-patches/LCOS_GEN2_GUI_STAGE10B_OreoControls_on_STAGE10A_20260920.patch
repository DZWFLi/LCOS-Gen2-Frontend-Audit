@@ -0,0 +1,124 @@
+@import './oreo-control-tokens.css';
+
+/* Oreo Button 23:11448 (16 actual variants), Icon Button 23:11978 (28).
+ * Paint belongs to the face. The original native button is the sole action owner.
+ * Never apply this skin to Arc, pin tiles or navigation capsules implicitly. */
+[data-lcos-control-skin='oreo'] {
+  --oreo-fill: var(--lcos-surface-base);
+  --oreo-ink: var(--lcos-text-primary);
+  --oreo-border: transparent;
+  --oreo-wash: transparent;
+  --oreo-hover: var(--lcos-color-interaction-hover);
+  --oreo-press: var(--lcos-color-interaction-press);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  box-sizing: border-box;
+  min-block-size: 44px;
+  min-inline-size: 44px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--oreo-ink);
+  vertical-align: middle;
+  font: inherit;
+  appearance: none;
+  cursor: pointer;
+}
+[data-lcos-control-skin='oreo'] > .lcos-oreo-face {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  box-sizing: border-box;
+  flex: 1 1 auto;
+  min-inline-size: 0;
+  min-block-size: var(--lcos-control-face-height, 32px);
+  padding: var(--lcos-space-x3, 6px) var(--lcos-space-12, 12px);
+  border: 0;
+  border-radius: var(--lcos-radius-control, 8px);
+  background-color: var(--oreo-fill);
+  background-image: linear-gradient(var(--oreo-wash), var(--oreo-wash));
+  color: var(--oreo-ink);
+  /* Figma inside strokes do not change content size or move its baseline. */
+  box-shadow: inset 0 0 0 .5px var(--oreo-border);
+  font-family: var(--lcos-control-font, 'Inter'), 'Noto Sans SC', 'Noto Sans CJK SC', sans-serif;
+  font-size: var(--lcos-control-font-size, 14px);
+  font-weight: var(--lcos-control-font-weight, 500);
+  line-height: var(--lcos-control-line-height, 20px);
+}
+.lcos-oreo-content { display: inline-flex; align-items: center; justify-content: center; gap: var(--lcos-space-x2, 4px); min-inline-size: 0; }
+.lcos-oreo-label { min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.lcos-oreo-label-icon { display: inline-flex; flex: 0 0 16px; inline-size: 16px; block-size: 16px; }
+.lcos-oreo-label-icon > :is(img, svg) { inline-size: 16px; block-size: 16px; display: block; }
+[data-lcos-control-skin='oreo'][data-lcos-control-type='primary'],
+[data-lcos-control-skin='oreo'][data-lcos-control-type='destructive'] {
+  --oreo-fill: var(--lcos-color-bg-inverse);
+  --oreo-ink: var(--lcos-color-text-on-inverse);
+  --oreo-hover: var(--lcos-color-interaction-hover-inverse);
+  --oreo-press: var(--lcos-color-interaction-press-inverse);
+}
+[data-lcos-control-skin='oreo'][data-lcos-control-type='destructive'] { --oreo-fill: var(--lcos-color-status-error); }
+[data-lcos-control-skin='oreo'][data-lcos-control-type='secondary'] { --oreo-border: var(--lcos-color-border-default); }
+[data-lcos-control-skin='oreo'][data-lcos-control-type='ghost'] { --oreo-fill: transparent; }
+@media (hover: hover) {
+  [data-lcos-control-skin='oreo']:hover:not(:disabled) { --oreo-wash: var(--oreo-hover); }
+}
