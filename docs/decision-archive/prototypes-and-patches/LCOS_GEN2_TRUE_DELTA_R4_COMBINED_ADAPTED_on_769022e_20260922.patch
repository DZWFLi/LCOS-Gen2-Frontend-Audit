@@ -0,0 +1,57 @@
+import type { CSSProperties, ReactNode } from 'react';
+
+import './lcos-floating-surfaces.css';
+
+export interface LcosObjectCommandMenuItem {
+  readonly id: string;
+  readonly label: string;
+  readonly shortcut?: string | undefined;
+  readonly disabledReason?: string | undefined;
+  readonly danger?: boolean | undefined;
+  readonly icon?: ReactNode | undefined;
+  readonly onSelect: () => void;
+}
+
+export interface LcosObjectCommandMenuViewProps {
+  readonly items: readonly LcosObjectCommandMenuItem[];
+  readonly label?: string | undefined;
+}
+
+/**
+ * Figma 5187:921 object menu presentation.
+ *
+ * Position/dismiss/clamp/focus ownership stays in Huabu Popover. This view only
+ * paints the menu body. Five rows produce the exact 248×265 Figma specimen;
+ * additional real commands extend by the same 47px cadence instead of being
+ * hidden to preserve a screenshot.
+ */
+export function LcosObjectCommandMenuView({ items, label = '节点命令' }: LcosObjectCommandMenuViewProps): React.JSX.Element {
+  return (
+    <div
+      data-lcos-object-command-menu
+      className="lcos-object-command-menu"
+      role="menu"
+      aria-label={label}
+      style={{ '--lcos-object-menu-rows': items.length } as CSSProperties}
+    >
+      {items.map((item) => (
+        <button
+          key={item.id}
+          type="button"
+          role="menuitem"
+          data-lcos-context-command={item.id}
+          data-danger={item.danger || undefined}
+          disabled={item.disabledReason !== undefined}
+          title={item.disabledReason ?? item.label}
+          aria-label={item.disabledReason ? `${item.label}，${item.disabledReason}` : item.label}
+          onClick={item.onSelect}
+          className="lcos-object-command-menu-row"
+        >
+          {item.icon ? <span className="lcos-object-command-menu-icon" aria-hidden>{item.icon}</span> : null}
+          <span className="lcos-object-command-menu-label">{item.label}</span>
+          {item.shortcut ? <kbd className="lcos-object-command-menu-shortcut">{item.shortcut}</kbd> : null}
+        </button>
+      ))}
+    </div>
+  );
+}
