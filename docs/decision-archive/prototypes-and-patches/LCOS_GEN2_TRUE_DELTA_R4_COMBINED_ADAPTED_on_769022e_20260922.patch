+  background: transparent;
+  color: var(--gen2-text, #242625);
+}
+.lcos-arc-more-row {
+  display: grid;
+  grid-template-columns: 20px minmax(0, 1fr);
+  align-items: start;
+  gap: 8px;
+  padding: 6px 10px;
