+}
+
+/* Figma 5187:921 — 248×265 at 5 rows, 47px row cadence. */
+.lcos-object-command-popover {
+  padding: 0 !important;
+  overflow: visible !important;
+  border: 0 !important;
+  border-radius: 15px !important;
+  background: transparent !important;
+  box-shadow: none !important;
+}
+.lcos-object-command-menu {
+  width: 248px;
+  max-width: calc(100vw - 24px);
+  height: calc(var(--lcos-object-menu-rows, 0) * 47px + 30px);
+  max-height: min(70vh, 500px);
+  padding: 2px 0 26px;
+  overflow-x: hidden;
+  overflow-y: auto;
+  border: 1px solid var(--gen2-border, #e7e9e7);
+  border-radius: 15px;
+  background: var(--gen2-surface, #fff);
+  box-shadow: 0 12px 18px rgb(0 0 0 / 8%);
+  backdrop-filter: blur(3px);
+  -webkit-backdrop-filter: blur(3px);
+}
+.lcos-object-command-menu-row {
+  box-sizing: border-box;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 70px;
+  align-items: center;
